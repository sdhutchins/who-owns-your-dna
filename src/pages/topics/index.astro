---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getNhgriRecords, getRecords, getTopics } from "../../lib/records";
import { withBase } from "../../lib/site";

const [projectRecords, nhgriRecords, topics] = await Promise.all([
  getRecords(),
  getNhgriRecords(),
  getTopics(),
]);

function countTopicRecords(topicSlug: string): number {
  const projectRecordCount = projectRecords.filter(
    (record) => record.topics.includes(topicSlug),
  ).length;
  const nhgriRecordCount = nhgriRecords.filter(
    (record) => record.mapped_topics.includes(topicSlug),
  ).length;
  return projectRecordCount + nhgriRecordCount;
}
---

<BaseLayout title="Topics">
  <Breadcrumbs items={[{ label: "Topics" }]} />
  <h1>Policy topics</h1>
  <p class="page-intro">Browse state and federal records through a consistent genetics and genomics policy vocabulary.</p>
  <p class="reading-width">
    Topic tags group records that discuss related issues. A shared tag does not
    mean that the records cover the same people, organizations, data, conduct,
    remedies, or level of legal protection. Counts combine project-authored
    records with an archived NHGRI policy snapshot.
  </p>
  <p class="reading-width">For additional policy context, explore <a href="https://www.ashg.org/advocacy/public-policy-positions/">ASHG’s public policy positions</a>.</p>

  <ul class="topic-grid section-block">
    {
      topics.map((topic) => {
        const recordCount = countTopicRecords(topic.slug);
        return (
          <li>
            <a href={withBase(`/topics/${topic.slug}/`)}>{topic.name}</a><br />
            <span class="topic-grid__description">{topic.description}</span><br />
            <span class="metadata">{recordCount.toLocaleString()} {recordCount === 1 ? "record" : "records"}</span>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
