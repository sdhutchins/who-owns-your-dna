---
import FileDownIcon from "@lucide/astro/icons/file-down";

import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getNhgriManifest, getRecords, getTopics } from "../../lib/records";
import { formatDate, REPOSITORY_URL, withBase } from "../../lib/site";

const records = await getRecords();
const topics = await getTopics();
const nhgriManifest = await getNhgriManifest();
const latestProjectReview = records[0]?.last_reviewed;
---

<BaseLayout title="Data">
  <Breadcrumbs items={[{ label: "About", href: "/about/" }, { label: "Data" }]} />
  <h1>Open policy data</h1>
  <p class="page-intro">Download this database or the archived NHGRI Genome Statute and Legislation Database.</p>

  <section class="data-catalog" aria-labelledby="available-data">
    <h2 id="available-data">Available data</h2>
    <div class="table-wrap">
      <table class="data-catalog-table">
        <thead>
          <tr>
            <th scope="col">Dataset</th>
            <th scope="col">Records</th>
            <th scope="col">Review or retrieval date</th>
            <th scope="col">Files</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row" data-label="Dataset">
              Who Owns Your DNA? database
              <span>Laws and policies checked against linked primary sources.</span>
            </th>
            <td data-label="Records">{records.length.toLocaleString()}</td>
            <td data-label="Latest review">
              {latestProjectReview ? formatDate(latestProjectReview) : "Not recorded"}
            </td>
            <td data-label="Files">
              <ul class="data-download-links">
                <li>
                  <a class="icon-link" href={withBase("/data/records.csv")} download>
                    <FileDownIcon class="interface-icon" size={16} />
                    <span>CSV</span>
                  </a>
                </li>
                <li>
                  <a class="icon-link" href={withBase("/data/records.json")} download>
                    <FileDownIcon class="interface-icon" size={16} />
                    <span>JSON</span>
                  </a>
                </li>
              </ul>
            </td>
          </tr>
          <tr>
            <th scope="row" data-label="Dataset">
              NHGRI database archive
              <span>Records preserved from the NHGRI Genome Statute and Legislation Database.</span>
            </th>
            <td data-label="Records">{nhgriManifest.record_count.toLocaleString()}</td>
            <td data-label="Retrieved">
              {formatDate(nhgriManifest.snapshot_fetched_at.slice(0, 10))}
            </td>
            <td data-label="Files">
              <ul class="data-download-links">
                <li>
                  <a class="icon-link" href={withBase("/data/nhgri-source-records.csv")} download>
                    <FileDownIcon class="interface-icon" size={16} />
                    <span>CSV</span>
                  </a>
                </li>
                <li>
                  <a class="icon-link" href={withBase("/data/nhgri-source-records.json")} download>
                    <FileDownIcon class="interface-icon" size={16} />
                    <span>JSON</span>
                  </a>
                </li>
                <li>
                  <a class="icon-link" href={withBase("/data/nhgri-source-manifest.json")} download>
                    <FileDownIcon class="interface-icon" size={16} />
                    <span>Manifest</span>
                  </a>
                </li>
              </ul>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="metadata">Downloads are generated from source data. Database records are maintained as YAML in the repository.</p>
    <p>Project-authored policy data and generated exports are available under <a href={`${REPOSITORY_URL}/blob/main/DATA-LICENSE.md`}>CC0 1.0 Universal</a>. You may copy, modify, redistribute, and use them commercially without permission. Citation is appreciated but not required. Third-party and archived source material retains its original rights and provenance.</p>
  </section>

  <section class="section-block reading-width">
    <h2>Repository and citation</h2>
    <ul class="reference-links">
      <li><a href={`${REPOSITORY_URL}/releases`}>Browse versioned data releases</a></li>
      <li><a href={REPOSITORY_URL}>View the source repository</a></li>
      <li><a href={`${REPOSITORY_URL}/blob/main/NOTICE.md`}>Review licensing scope and source notices</a></li>
      <li><a href={withBase("/cite/")}>Read the citation guidance</a></li>
      <li><a href={withBase("/sources/nhgri/")}>Search the NHGRI database archive</a></li>
    </ul>
  </section>

  <section class="section-block reading-width">
    <h2>What the records contain</h2>
    <p>This database includes identifiers, jurisdiction, type, status, review and version details, {topics.length} topics, summaries, sources, and history. The build checks each source file.</p>
    <p>Archived NHGRI records retain their original wording and archive details, including the source, retrieval date, and checksums.</p>
  </section>
</BaseLayout>
