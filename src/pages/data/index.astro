---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getNhgriManifest, getRecords, getTopics } from "../../lib/records";
import { REPOSITORY_URL, withBase } from "../../lib/site";

const records = await getRecords();
const topics = await getTopics();
const nhgriManifest = await getNhgriManifest();
const totalRecordCount = records.length + nhgriManifest.record_count;
---

<BaseLayout title="Data">
  <Breadcrumbs items={[{ label: "About", href: "/about/" }, { label: "Data" }]} />
  <h1>Open policy data</h1>
  <p class="page-intro">The website is a public interface for a structured, version-controlled policy dataset.</p>

  <dl class="metadata-list">
    <dt>Prototype version</dt><dd>0.1.0</dd>
    <dt>Records</dt><dd>{totalRecordCount}</dd>
    <dt>Topics</dt><dd>{topics.length}</dd>
    <dt>Release date</dt><dd>Not yet released</dd>
    <dt>Repository</dt><dd><a href={REPOSITORY_URL}>GitHub source repository</a></dd>
    <dt>License</dt><dd>To be selected before the first dataset release</dd>
    <dt>Zenodo DOI</dt><dd>Planned for a future dataset release</dd>
  </dl>

  <section>
    <h2>Project record downloads</h2>
    <div class="action-row">
      <a class="button-link" href={withBase("/data/records.csv")} download>Download CSV</a>
      <a class="button-link button-link--secondary" href={withBase("/data/records.json")} download>Download JSON</a>
    </div>
    <p class="metadata">Project-authored YAML files remain in the repository. CSV and JSON are reproducible build artifacts.</p>
  </section>

  <section class="section-block">
    <h2>NHGRI provenance downloads</h2>
    <p class="reading-width">These files reproduce records retrieved from NHGRI. The manifest identifies the source URL, retrieval timestamp, source-page date, and checksums. All records appear in the combined Policy Records directory.</p>
    <div class="action-row">
      <a class="button-link" href={withBase("/data/nhgri-source-records.csv")} download>Download NHGRI source CSV</a>
      <a class="button-link button-link--secondary" href={withBase("/data/nhgri-source-records.json")} download>Download NHGRI source JSON</a>
      <a href={withBase("/data/nhgri-source-manifest.json")} download>Download provenance manifest</a>
    </div>
    <p><a href={withBase("/sources/nhgri/")}>Search the NHGRI source archive</a></p>
  </section>

  <section class="section-block reading-width">
    <h2>Data model</h2>
    <p>Each record has a stable identifier, jurisdiction, record type, legal status, review date, record version, controlled topic tags, factual and plain-language summaries, primary sources, and record history. Optional fields support statutes, regulations, court decisions, bills, archived sources, checksums, and review metadata.</p>
    <p>Presentation code does not contain the substantive legal records. A schema validator checks the source files before the site builds.</p>
    <p>Records retrieved from NHGRI retain a separate source schema so their original wording and provenance remain intact. The public directory combines both schemas and uses one shared status vocabulary.</p>
  </section>
</BaseLayout>
