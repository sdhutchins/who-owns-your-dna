---
import SearchIcon from "@lucide/astro/icons/search";

import BaseLayout from "../layouts/BaseLayout.astro";
import StatusLabel from "../components/StatusLabel.astro";
import { getNhgriRecords, getRecords } from "../lib/records";
import { withBase } from "../lib/site";

const [records, nhgriRecords] = await Promise.all([
  getRecords(),
  getNhgriRecords(),
]);
const totalRecordCount = records.length + nhgriRecords.length;
const featuredRecords = [...records]
  .sort((left, right) => right.last_reviewed.localeCompare(left.last_reviewed))
  .slice(0, 4);
---

<BaseLayout>
  <section class="intro-band">
    <h1>Find U.S. laws and policies about genetic information</h1>
    <p class="intro-band__summary">
      Explore selected federal and state laws and policies on genetic privacy, discrimination,
      testing, research, insurance, and data use.
    </p>
    <div class="homepage-search-region">
      <form class="homepage-record-search" action={withBase("/records/")} method="get" role="search">
        <label class="sr-only" for="homepage-record-query">Search laws and policies</label>
        <div class="homepage-record-search__controls">
          <input id="homepage-record-query" name="q" type="search" placeholder="Search a law, state, topic, or bill number" />
          <button type="submit">
            <SearchIcon class="interface-icon" size={18} />
            <span>Search database</span>
          </button>
        </div>
      </form>
      <p class="homepage-record-link">
        <a href={withBase("/records/")}>Search all {totalRecordCount.toLocaleString()} laws and policies</a>
      </p>
    </div>
  </section>

  <section class="homepage-browse" aria-labelledby="browse-policy">
    <h2 id="browse-policy">Browse the database</h2>
    <ul class="homepage-directory">
      <li>
        <h3><a href={withBase("/states/")}>State Laws Database</a></h3>
        <p>Find laws and policies for a state or the District of Columbia.</p>
      </li>
      <li>
        <h3><a href={withBase("/federal/")}>Federal Laws Database</a></h3>
        <p>Find federal statutes, regulations, agency guidance, and research policies.</p>
      </li>
      <li>
        <h3><a href={withBase("/topics/")}>Topics</a></h3>
        <p>Browse records by privacy, discrimination, research, testing, insurance, or data use.</p>
      </li>
    </ul>
  </section>

  <section class="homepage-recent section-block" aria-labelledby="recently-reviewed">
    <div class="section-heading-row">
      <h2 id="recently-reviewed">From the database</h2>
      <a href={withBase("/records/?source=project")}>Search this database</a>
    </div>
    <ol class="recent-review-list">
      {featuredRecords.map((record) => (
        <li>
          <div>
            <a href={withBase(`/records/${record.id}/`)}>{record.identifier}: {record.title}</a>
            <span>{record.jurisdiction}</span>
          </div>
          <StatusLabel status={record.status} />
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
