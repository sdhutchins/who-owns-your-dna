---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getRecords } from "../../lib/records";
import { withBase } from "../../lib/site";

const federalRecords = (await getRecords()).filter(
  (record) => record.jurisdiction_type === "federal",
);
const recordsUrl = `/records/?jurisdiction=${encodeURIComponent("United States")}`;
---

<BaseLayout title="Federal policy">
  <Breadcrumbs items={[{ label: "Federal" }]} />
  <h1>Federal law and policy</h1>
  <p class="page-intro">Browse {federalRecords.length.toLocaleString()} project-reviewed federal genetics and genomics policy {federalRecords.length === 1 ? "record" : "records"}.</p>
  <p class="reading-width">
    This selected collection is not a complete inventory of federal law or policy.
  </p>

  <p><a class="button-link" href={withBase(recordsUrl)}>View federal records</a></p>
</BaseLayout>
