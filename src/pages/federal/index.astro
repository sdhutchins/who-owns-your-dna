---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getRecords } from "../../lib/records";
import { withBase } from "../../lib/site";

const federalRecords = (await getRecords()).filter(
  (record) => record.jurisdiction_type === "federal",
);
const recordsUrl = `/records/?jurisdiction=${encodeURIComponent("United States")}`;
---

<BaseLayout title="Federal Laws Database">
  <Breadcrumbs items={[{ label: "Federal" }]} />
  <h1>Federal Laws Database</h1>
  <p class="page-intro">Explore {federalRecords.length.toLocaleString()} federal {federalRecords.length === 1 ? "law or policy" : "laws and policies"} related to genetics and genomics.</p>
  <p class="reading-width">
    This is a selected collection, not a complete list of federal laws and policies.
  </p>

  <p><a class="button-link" href={withBase(recordsUrl)}>Search federal laws and policies</a></p>
</BaseLayout>
