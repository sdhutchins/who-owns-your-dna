---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  download?: boolean | string;
}

const {
  href,
  variant = "primary",
  download = false,
} = Astro.props;
---

<a
  class:list={["action-link", `action-link--${variant}`]}
  href={href}
  download={download}
>
  <slot />
</a>
