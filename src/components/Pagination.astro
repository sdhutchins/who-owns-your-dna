---
interface Props {
  totalCount: number;
  pageSize?: number;
  label: string;
  noun?: string;
}

const {
  totalCount,
  pageSize = 50,
  label,
  noun = "records",
} = Astro.props;
const initialEnd = Math.min(pageSize, totalCount);
const pageCount = Math.max(1, Math.ceil(totalCount / pageSize));
---

<nav
  class="pagination"
  aria-label={label}
  data-pagination
  data-page-size={pageSize}
  data-noun={noun}
>
  <p class="pagination__summary" data-pagination-summary aria-live="polite">
    Showing {totalCount === 0 ? 0 : 1}–{initialEnd} of {totalCount.toLocaleString()} {noun}
  </p>
  <div class="pagination__controls">
    <button type="button" data-pagination-previous disabled>Previous</button>
    <span class="pagination__page" data-pagination-page>Page 1 of {pageCount}</span>
    <button type="button" data-pagination-next disabled={pageCount === 1}>Next</button>
  </div>
</nav>
