---
import type {
  LegalRecord,
  NhgriManifest,
  NhgriSourceRecord,
  Topic,
} from "../lib/records";
import { formatDate, humanizeStatus, withBase } from "../lib/site";
import TableRegion from "./TableRegion.astro";

interface Props {
  projectRecords: LegalRecord[];
  nhgriRecords: NhgriSourceRecord[];
  topics: Topic[];
  manifest: NhgriManifest;
  bodyId?: string;
  label?: string;
}

const {
  projectRecords,
  nhgriRecords,
  topics,
  manifest,
  bodyId,
  label = "Policy records",
} = Astro.props;
const topicNames = new Map(topics.map((topic) => [topic.slug, topic.name]));
const snapshotDate = manifest.snapshot_fetched_at.slice(0, 10);

function getProjectRecordDate(record: LegalRecord): {
  label: string;
  value: string | null;
} {
  if (record.effective_date) {
    return { label: "Effective", value: record.effective_date };
  }
  if (record.signed_date) {
    return { label: "Signed", value: record.signed_date };
  }
  if (record.last_action_date) {
    return { label: "Last action", value: record.last_action_date };
  }
  if (record.introduced_date) {
    return { label: "Introduced", value: record.introduced_date };
  }
  return { label: "Last reviewed", value: record.last_reviewed };
}

function searchText(values: Array<string | undefined>): string {
  return values.filter(Boolean).join(" ").toLocaleLowerCase();
}
---

<TableRegion label={label}>
  <table class="policy-record-table">
    <caption class="sr-only">{label}</caption>
    <thead>
      <tr>
        <th scope="col">Jurisdiction</th>
        <th scope="col">Law or policy</th>
        <th scope="col">Topics</th>
        <th scope="col">Status</th>
        <th scope="col">Summary</th>
      </tr>
    </thead>
    <tbody id={bodyId}>
      {projectRecords.map((record) => {
        const date = getProjectRecordDate(record);
        const year = date.value?.slice(0, 4) ?? "not-stated";
        const primarySource = record.primary_sources[0];
        const displayTopics = record.topics.map(
          (topic) => topicNames.get(topic) ?? topic,
        );
        return (
          <tr
            data-policy-record
            data-search={searchText([
              record.jurisdiction,
              record.title,
              record.identifier,
              record.summary,
              ...displayTopics,
            ])}
            data-title-search={searchText([record.title])}
            data-identifier-search={searchText([record.identifier])}
            data-jurisdiction-search={searchText([record.jurisdiction])}
            data-topic-search={searchText(displayTopics)}
            data-summary-search={searchText([record.summary])}
            data-jurisdiction={record.jurisdiction}
            data-topics={JSON.stringify(record.topics.map((topic) => `project:${topic}`))}
            data-status={record.status}
            data-year={year}
            data-source-layer="project"
            data-record-type={record.record_type}
            data-sort-date={record.last_reviewed}
            data-sort-title={record.title.toLocaleLowerCase()}
            data-sort-jurisdiction={record.jurisdiction.toLocaleLowerCase()}
          >
            <th scope="row" data-label="Jurisdiction">{record.jurisdiction}</th>
            <td class="policy-record-table__primary" data-label="Law or policy">
              <a href={withBase(`/records/${record.id}/`)}>{record.title}</a>
              <span class="policy-record-table__source">Source: Project review</span>
              <span class="policy-record-table__date">
                {humanizeStatus(record.record_type)} · {date.label}: {formatDate(date.value)}
              </span>
              <span class="policy-record-table__review">
                Last reviewed {formatDate(record.last_reviewed)}
              </span>
              {primarySource && <a class="policy-record-table__official" href={primarySource.url}>Official source</a>}
            </td>
            <td data-label="Topics">{displayTopics.join(", ")}</td>
            <td data-label="Status">{humanizeStatus(record.status)}</td>
            <td data-label="Summary">{record.summary}</td>
          </tr>
        );
      })}
      {nhgriRecords.map((record) => (
        <tr
          data-policy-record
          data-search={searchText([
            record.jurisdiction,
            record.source_record_label,
            record.source_summary,
            ...record.source_topics,
          ])}
          data-title-search={searchText([record.source_record_label])}
          data-identifier-search={searchText([record.source_record_label])}
          data-jurisdiction-search={searchText([record.jurisdiction])}
          data-topic-search={searchText(record.source_topics)}
          data-summary-search={searchText([record.source_summary])}
          data-jurisdiction={record.jurisdiction}
          data-topics={JSON.stringify([
            ...record.source_topics.map((topic) => `nhgri:${topic}`),
            ...record.mapped_topics.map((topic) => `project:${topic}`),
          ])}
          data-status={record.base_status}
          data-year={record.inferred_year ?? "not-stated"}
          data-source-layer="nhgri"
          data-record-type="archived-source"
          data-sort-date={snapshotDate}
          data-sort-title={record.source_record_label.toLocaleLowerCase()}
          data-sort-jurisdiction={record.jurisdiction.toLocaleLowerCase()}
        >
          <th scope="row" data-label="Jurisdiction">{record.jurisdiction}</th>
          <td class="policy-record-table__primary" data-label="Law or policy">
            <a href={withBase(`/source-records/nhgri/${record.id}/`)}>{record.source_record_label}</a>
            <span class="policy-record-table__source">Source: Archived NHGRI database</span>
            <span class="policy-record-table__date">
              {record.inferred_year ? `${record.inferred_year} legislative session` : "Date not stated in source label"}
            </span>
            <span class="policy-record-table__review">
              Retrieved {formatDate(snapshotDate)}
            </span>
            <a class="policy-record-table__official" href={record.primary_url}>Official source</a>
          </td>
          <td data-label="Topics">{record.source_topics.join(", ")}</td>
          <td data-label="Status">{humanizeStatus(record.base_status)}</td>
          <td data-label="Summary">{record.source_summary}</td>
        </tr>
      ))}
    </tbody>
  </table>
</TableRegion>
